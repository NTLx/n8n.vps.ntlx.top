    {
      "id": "e005e275-9148-4532-8d0e-9ead63909650",
      "name": "Parse latest changelog snapshot",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        560,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => { const md = $(\"Fetch n8n changelog\").item.json.markdown || \"\"; const versions = md.match(/Current `stable`:\\s*([^\\s]+)\\s+Current `beta`:\\s*([^\\s]+)/) || []; const headings = [...md.matchAll(/^##\\s+(.+)$/gm)]; if (!headings.length) throw new Error(\"No changelog entry heading found\"); const first = headings[0]; const second = headings[1]; const entry = md.slice(first.index, second ? second.index : md.length).trim(); const releasedMatch = entry.match(/\\*\\*Released:\\*\\*\\s*([^\\n]+)/) || []; const title = first[1].replace(/\\[([^\\]]+)\\]\\([^)]+\\)/g, \"$1\").trim(); const stable = versions[1] || \"\"; const beta = versions[2] || \"\"; const normalizedEntry = entry.replace(/\\s+/g, \" \").trim(); return { source_url: \"https://docs.n8n.io/changelog/\", markdown_url: \"https://docs.n8n.io/changelog/readme.md\", stable_version: stable, beta_version: beta, title, released: (releasedMatch[1] || \"\").trim(), entry_markdown: entry, snapshot_text: `stable=${stable}\\nbeta=${beta}\\n${normalizedEntry}` }; })() }}",
        "includeOtherFields": false
      }
    },
    {
      "id": "dfb26994-1552-43fd-a7af-ab5b933f22ba",
      "name": "Hash changelog snapshot",
      "type": "n8n-nodes-base.crypto",
