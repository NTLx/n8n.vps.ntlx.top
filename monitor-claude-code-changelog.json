      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => { const xml = $(\"Fetch Claude Code changelog feed\").item.json.xml || \"\"; const feedUpdated = (xml.match(/<feed[^>]*>[\\s\\S]*?<updated>([^<]+)<\\/updated>/) || [])[1] || \"\"; const entryMatch = xml.match(/<entry>([\\s\\S]*?)<\\/entry>/); if (!entryMatch) throw new Error(\"No Claude Code changelog entry found\"); const entry = entryMatch[1]; const id = (entry.match(/<id>([^<]+)<\\/id>/) || [])[1] || \"\"; const title = (entry.match(/<title>([^<]+)<\\/title>/) || [])[1] || \"\"; const updated = (entry.match(/<updated>([^<]+)<\\/updated>/) || [])[1] || \"\"; const contentEncoded = (entry.match(/<content[^>]*>([\\s\\S]*?)<\\/content>/) || [])[1] || \"\"; const html = contentEncoded.replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&quot;/g, \"\\\"\").replace(/&#39;/g, \"'\").replace(/&amp;/g, \"&\"); const notes = html.replace(/<br\\s*\\/?>/gi, \"\\n\").replace(/<\\/p>/gi, \"\\n\").replace(/<[^>]+>/g, \"\").replace(/\\n{3,}/g, \"\\n\\n\").trim(); const version = ((title.match(/v?(\\d+\\.\\d+\\.\\d+)/) || [])[1] || title.replace(/^Claude Code\\s+v?/i, \"\").trim()); return { source_url: id || \"https://github.com/anthropics/claude-code/releases\", feed_url: \"https://raw.githubusercontent.com/anthropics/claude-code/main/feed.xml\", changelog_url: \"https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md\", feed_updated: feedUpdated, version, title, updated, release_notes: notes, snapshot_text: `${id}\\n${title}\\n${updated}\\n${notes}` }; })() }}",
        "includeOtherFields": false
      }
    },
