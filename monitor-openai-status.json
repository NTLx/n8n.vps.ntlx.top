    {
      "id": "c0560392-5ec0-4681-a206-202c7f066ce3",
      "name": "Extract OpenAI status changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const payload = $('Fetch OpenAI incidents').first().json;\nconst state = $input.first().json;\nconst fromMs = new Date(state.lastPollAt).getTime();\nconst pollStartedAt = new Date().toISOString();\nconst toMs = new Date(pollStartedAt).getTime();\nconst output = [];\nconst incidents = Array.isArray(payload.incidents) ? payload.incidents : [];\nfor (const incident of incidents) {\n  const updates = Array.isArray(incident.incident_updates) ? incident.incident_updates : [];\n  for (const update of updates) {\n    const revisionAt = update.updated_at || update.created_at || incident.updated_at;\n    const revisionMs = new Date(revisionAt).getTime();\n    if (!Number.isFinite(revisionMs) || revisionMs < fromMs || revisionMs > toMs) continue;\n    const eventId = `openai-status:${update.id}:${revisionAt}`;\n    output.push({ json: {\n      item_type: 'event',\n      poll_started_at: pollStartedAt,\n      event_id: eventId,\n      update_id: update.id,\n      incident_id: incident.id,\n      incident_name: incident.name,\n      incident_status: update.status || incident.status || 'unknown',\n      incident_impact: incident.impact || 'unknown',\n      revision_at: revisionAt,\n      display_at: update.display_at || update.created_at || revisionAt,\n      body: update.body || '',\n      source_url: 'https://status.openai.com/'\n    }});\n  }\n}\noutput.sort((a, b) => new Date(a.json.revision_at).getTime() - new Date(b.json.revision_at).getTime());\noutput.push({ json: { item_type: 'cursor', poll_started_at: pollStartedAt } });\nreturn output;"
      }
    },
