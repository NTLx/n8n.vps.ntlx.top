    {
      "id": "d25e37a6-b22e-4cda-a54a-cfdbab84c255",
      "name": "Prepare Discord Delivery",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        520,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "channel-id",
              "name": "channelId",
              "type": "string",
              "value": "={{ String($('Receive Discord Markdown').item.json.channel || 'status').toLowerCase() === 'feeds' ? '1224879319499800676' : '1224990958718812170' }}"
            },
            {
              "id": "message-chunks",
              "name": "messageChunks",
              "type": "array",
              "value": "={{ (() => { const md = String($('Receive Discord Markdown').item.json.markdown || '').trim(); if (!md) throw new Error('markdown is required'); const chunks = []; let rest = md; const max = 1800; while (rest.length > max) { let cut = rest.lastIndexOf('\\n\\n', max); if (cut < 900) cut = rest.lastIndexOf('\\n', max); if (cut < 900) cut = rest.lastIndexOf(' ', max); if (cut < 900) cut = max; let part = rest.slice(0, cut).trimEnd(); rest = rest.slice(cut).trimStart(); const fences = (part.match(/```/g) || []).length; if (fences % 2 === 1) { const matches = [...part.matchAll(/```([^\\n`]*)\\n/g)]; const lang = matches.length ? String(matches[matches.length - 1][1] || '').trim() : ''; part += '\\n```'; rest = '```' + lang + '\\n' + rest; } chunks.push(part); } if (rest.trim()) chunks.push(rest.trim()); return chunks; })() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "da79499d-de04-4649-8f35-8141876b16b4",
