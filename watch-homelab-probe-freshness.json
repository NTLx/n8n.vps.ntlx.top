      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = Date.now();\nconst nowIso = new Date(now).toISOString();\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json || {};\n  if (!r.state_key || !r.node_id || !r.scope || !r.last_seen_at) continue;\n  const last = Date.parse(r.last_seen_at);\n  if (!Number.isFinite(last)) continue;\n  const thresholdMs = r.scope === 'health' ? 45 * 60 * 1000 : 30 * 60 * 60 * 1000;\n  if (now - last <= thresholdMs) continue;\n  if (String(r.coverage_status || '') === 'stale' && String(r.incident_id || '').startsWith('homelab-stale:')) continue;\n  const stamp = String(r.last_seen_at).replace(/[^0-9]/g, '').slice(0,14);\n  const incidentId = 'homelab-stale:' + r.state_key + ':' + stamp;\n  const eventId = 'homelab.ops.coverage_change:' + r.state_key + ':stale:' + stamp;\n  const deadline = new Date(now + (r.scope === 'health' ? 3 : 26) * 3600000).toISOString();\n  const workId = 'homelab_ops:' + r.node_id + ':' + r.scope + ':probe_stale:' + stamp;\n  const ageMinutes = Math.floor((now - last) / 60000);\n  out.push({ json: { ...r, status: 'coverage_degraded', coverage_status: 'stale', consecutive_failures: Math.max(Number(r.consecutive_failures || 0) + 1, 2), consecutive_successes: 0, incident_id: incidentId, incident_started_at: nowIso, last_change_at: nowIso, worker: 'hourly', kind: 'homelab_ops_review', priority: r.scope === 'health' ? 8 : 12, source_event_id: eventId, correlation_id: incidentId, project: 'home-infrastructure', input_ref: 'homelab://state/' + r.state_key + '?reason=probe_stale&last_seen_at=' + encodeURIComponent(r.last_seen_at) + '&incident_id=' + encodeURIComponent(incidentId), summary: 'Homelab probe coverage stale for ' + r.node_id + ' / ' + r.scope + '; last_seen_at=' + r.last_seen_at + '; age_minutes=' + ageMinutes + '.', deadline, event_id: eventId, event_occurred_at: nowIso, event_source: 'n8n:homelab-probe-deadman', event_category: 'homelab.ops.coverage_change', event_title: 'Homelab probe coverage stale: ' + r.node_id + ' / ' + r.scope, event_description: 'Deterministic probe deadman detected stale coverage. Last seen ' + r.last_seen_at + '; age_minutes=' + ageMinutes + '.', event_status: 'coverage_degraded', event_url: '', event_metadata_object: JSON.stringify({ node_id: r.node_id, scope: r.scope, reason: 'probe_stale', last_seen_at: r.last_seen_at, detected_at: nowIso, age_minutes: ageMinutes, incident_id: incidentId, prior_status: r.status || null, prior_coverage_status: r.coverage_status || null }) }});\n}\nreturn out;"
