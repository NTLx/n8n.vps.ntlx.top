      "position": [
        0,
        336
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "ai_work_queue"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            },
            {
              "keyName": "not_before",
              "condition": "lte",
              "keyValue": "={{ $now.toISO() }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 20,
        "orderBy": true,
        "orderByColumn": "priority",
        "orderByDirection": "ASC"
      }
