      "name": "Automation Runtime MCP",
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 2.1,
      "position": [
        384,
        112
      ],
      "parameters": {
        "authentication": "bearerAuth",
        "path": "automation-runtime",
        "instructions": "This is the durable runtime API for ChatGPT's cognitive automation plane. n8n does not reason. Workflow: (1) List Pending AI Work, sorted with lower numeric priority first. (2) Claim exactly one eligible work_id before cognitive work. (3) Use direct MCPs and ServerFS Agents outside n8n for reasoning/execution. (4) Always finish the claimed item with Complete, Defer, Fail, or Block. Defer is for unfinished asynchronous work and can persist result_ref such as a ServerFS task_id so a later dispatcher run can resume. Record Work Event for important terminal outcomes. Current kinds: ci_triage = inspect GitHub jobs/logs and reason about root cause; wiki_compile = compile the URL through the agentic-work-atlas repository workflow using ServerFS/Agent; rss_review = retrieve and evaluate the article in ChatGPT. Do not invent results when referenced systems are unavailable."
      },
      "webhookId": "4c6d110d-a314-429e-9f2c-54dd8c2239be",
      "credentials": {
        "httpBearerAuth": {
          "id": "C6qLO178JVZklDXs",
          "name": "外部调用n8n的MCP"
        }
      }
    },
