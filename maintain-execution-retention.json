    {
      "id": "4b2991ff-3eb7-475a-aa58-890efd9342fe",
      "name": "Keep retention targets",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        672,
        0
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ (() => {\n            const e = $('List executions').item.json;\n            const p = $('Normalize policy').first().json;\n            const started = DateTime.fromISO(e.startedAt);\n            if (e.status === 'success') return started < DateTime.now().minus({ hours: p.successRetentionHours }) ? 'delete' : 'keep';\n            if (['error', 'crashed', 'waiting'].includes(e.status)) return started < DateTime.now().minus({ days: p.issueRetentionDays }) ? 'delete' : 'keep';\n            return 'keep';\n          })() }}",
              "rightValue": "delete",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
