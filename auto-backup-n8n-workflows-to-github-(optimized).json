    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst localWorkflows = $('Fetch Local Workflows').all().map(item => item.json);\nconst remoteFiles = $('Fetch GitHub Files').all().map(item => item.json);\n\nconst getFileName = (name) => {\n  const base = String(name ?? '')\n    .trim()\n    .replace(/[\\\\/]+/g, '-')\n    .replace(/\\s+/g, '-')\n    .toLowerCase();\n\n  if (!base) {\n    throw new Error('Backup aborted: workflow name cannot produce an empty filename.');\n  }\n\n  return `${base}.json`;\n};\n\nconst getGitBlobSha = (content) => {\n  const body = Buffer.from(content, 'utf8');\n  const header = Buffer.from(`blob ${body.length}\\0`, 'utf8');\n  return crypto.createHash('sha1').update(header).update(body).digest('hex');\n};\n\nconst localMap = new Map();\nfor (const workflow of localWorkflows) {\n  const fileName = getFileName(workflow.name);\n\n  if (localMap.has(fileName)) {\n    const previous = localMap.get(fileName);\n    throw new Error(\n      `Backup aborted: filename collision for \"${fileName}\" between workflows ` +\n      `\"${previous.workflowName}\" (${previous.workflowId}) and ` +\n      `\"${workflow.name}\" (${workflow.id}). Rename one workflow before retrying.`\n    );\n  }\n\n  const content = JSON.stringify(workflow, null, 2);\n  localMap.set(fileName, {\n    workflowId: workflow.id,\n    workflowName: workflow.name,\n    content,\n    blobSha: getGitBlobSha(content),\n  });\n}\n\nconst remoteMap = new Map();\nfor (const file of remoteFiles) {\n  if (file.name && file.type === 'file' && file.name.endsWith('.json')) {\n    remoteMap.set(file.name, file.sha);\n  }\n}\n\nconst results = [];\n\nfor (const [fileName, local] of localMap.entries()) {\n  const remoteSha = remoteMap.get(fileName);\n\n  if (!remoteSha) {\n    results.push({\n      json: {\n        action: 'create',\n        fileName,\n        content: local.content,\n        workflowId: local.workflowId,\n        workflowName: local.workflowName,\n      },\n    });\n    continue;\n  }\n\n  if (remoteSha !== local.blobSha) {\n    results.push({\n      json: {\n        action: 'update',\n        fileName,\n        content: local.content,\n        workflowId: local.workflowId,\n        workflowName: local.workflowName,\n        localBlobSha: local.blobSha,\n        remoteBlobSha: remoteSha,\n      },\n    });\n  }\n}\n\nfor (const fileName of remoteMap.keys()) {\n  if (!localMap.has(fileName)) {\n    results.push({\n      json: {\n        action: 'delete',\n        fileName,\n      },\n    });\n  }\n}\n\nreturn results;"
      },
