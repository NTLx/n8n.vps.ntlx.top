      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "input-ref",
              "name": "input_ref",
              "value": "={{ String($json.link ?? $json.guid ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "title",
              "name": "title",
              "value": "={{ $json.title ?? 'RSS article' }}",
              "type": "string"
            },
            {
              "id": "work-id",
              "name": "work_id",
              "value": "={{ 'rss_review:' + String($json.link ?? $json.guid ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "event-id",
              "name": "event_id",
              "value": "={{ 'rss.article.discovered:' + String($json.link ?? $json.guid ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "correlation-id",
              "name": "correlation_id",
              "value": "={{ 'rss_review:' + String($json.link ?? $json.guid ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "summary",
              "name": "summary",
              "value": "={{ 'Review RSS article: ' + ($json.title ?? 'Untitled') }}",
              "type": "string"
            },
            {
              "id": "published",
              "name": "published_at",
              "value": "={{ $json.isoDate ?? $json.pubDate ?? '' }}",
              "type": "string"
            },
            {
              "id": "author",
              "name": "author",
              "value": "={{ $json.creator ?? $json.author ?? '' }}",
              "type": "string"
            },
            {
              "id": "not-before",
              "name": "not_before",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
