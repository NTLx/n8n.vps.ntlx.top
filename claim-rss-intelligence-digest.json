    {
      "id": "fda86f0a-8397-470e-bc55-cc05f8e272f3",
      "name": "Validate Digest Contract",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        224,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ (()=>{const b=$json.body||{};if(typeof b.digest_id!=='string')return 'invalid';const m=/^rss-digest:(\\d{4}-\\d{2}-\\d{2})$/.exec(b.digest_id);if(!m)return 'invalid';const dt=new Date(m[1]+'T00:00:00.000Z');if(!Number.isFinite(dt.getTime())||dt.toISOString().slice(0,10)!==m[1])return 'invalid';const n=Number(b.limit??100);if(!Number.isInteger(n)||n<1||n>100)return 'invalid';if(Object.hasOwn(b,'stale_before')||Object.hasOwn(b,'recover_from_digest')||b.recover_stale===true)return 'invalid';return 'valid';})() }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "valid"
            }
          ],
          "combinator": "and"
        },
        "options": {
          "ignoreCase": false
        }
      }
    },
