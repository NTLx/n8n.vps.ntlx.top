              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "yes"
            }
          ],
          "combinator": "and"
        },
        "options": {
          "ignoreCase": false
        }
      }
    },
    {
      "id": "f4536510-316a-4d06-abe2-ec0351ed00d0",
