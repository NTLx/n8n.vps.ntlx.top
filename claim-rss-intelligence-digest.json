    {
      "id": "70438b17-b4c8-4876-9a64-fe9641795ddb",
      "name": "Summarize RSS Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b=$('Claim RSS Digest').first().json.body;const expected=$('Get Fresh RSS Items').all().map(x=>x.json).filter(r=>r.status==='new'&&Number.isInteger(Number(r.id))&&Number(r.id)>0);const returned=$input.all().map(x=>x.json).filter(r=>Number.isInteger(Number(r.id))&&r.status==='processing'&&r.digest_id===b.digest_id);const allowed=new Set(expected.map(x=>Number(x.id)));const matched=returned.filter(x=>allowed.has(Number(x.id)));const ok=expected.length===matched.length&&new Set(matched.map(x=>Number(x.id))).size===matched.length&&returned.length===matched.length;return [{json:{ok,type:'rss_claim',digest_id:b.digest_id,requested_limit:Number(b.limit??100),expected_count:expected.length,claimed_count:matched.length,recovered_count:0,claimed_item_keys:matched.map(x=>x.item_key).filter(Boolean),batch_recovery_policy:'new_only; never reassign processing from another digest',error:ok?'':'claim_count_mismatch'}}];"
      }
    },
